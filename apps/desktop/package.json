{
  "name": "ai-disk-desktop",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "postinstall": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task postinstall",
    "dev": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task dev:fast",
    "dev:frontend": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task frontend:dev",
    "dev:tauri": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task dev",
    "build": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task build",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task build:exe",
    "frontend:dev": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task frontend:dev",
    "frontend:build": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task frontend:build",
    "scan:timing:mft": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task scan:timing:mft",
    "scan:timing:mft:normal": "powershell -ExecutionPolicy Bypass -File ../../scripts/run_desktop_npm_task.ps1 -Task scan:timing:mft:normal"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
